<?xml version="1.0" encoding="utf-8"?>
<!--
  Three stacked layers make the glass: a translucent tinted body that lets the
  wallpaper through, a diagonal sheen, and a bright rim. One flat colour reads
  as plastic; these three read as a pane.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- 1 · the body -->
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="30dp" />
      <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="@color/kalima_glass_top"
        android:endColor="@color/kalima_glass_bottom" />
    </shape>
  </item>

  <!-- 2 · the sheen, brightest at the top-left -->
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="30dp" />
      <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="@color/kalima_sheen"
        android:endColor="@color/kalima_sheen_fade" />
    </shape>
  </item>

  <!-- 3 · the rim -->
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="30dp" />
      <stroke android:width="1dp" android:color="@color/kalima_glass_rim" />
    </shape>
  </item>

</layer-list>
