<?xml version="1.0" encoding="utf-8"?>
<!-- The card paints its own ground: gradient underneath, glass pane on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="28dp" />
      <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="@color/kalima_brand"
        android:endColor="@color/kalima_brand_alt" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="28dp" />
      <solid android:color="@color/kalima_glass_pane" />
      <stroke android:width="1dp" android:color="@color/kalima_glass_rim" />
    </shape>
  </item>
</layer-list>
