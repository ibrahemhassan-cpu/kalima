<?xml version="1.0" encoding="utf-8"?>
<!--
  Every class here is one RemoteViews accepts: LinearLayout, TextView,
  ImageView, ImageButton. Nothing else may appear — plain View included.
  The glass look comes entirely from kalima_widget_bg.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/kalima_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/kalima_widget_bg"
  android:padding="12dp">

  <!--
    Controls pinned to the top, speaker left and next right.
    layoutDirection is forced to ltr so they stay physically where the user
    put them — an Arabic locale would otherwise mirror the whole row.
  -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layoutDirection="ltr">

    <ImageButton
      android:id="@+id/kalima_speak"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:padding="8dp"
      android:background="@drawable/kalima_pill"
      android:src="@drawable/kalima_ic_speak"
      android:scaleType="fitCenter"
      android:contentDescription="@string/kalima_widget_speak" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1"
      android:text="" />

    <ImageButton
      android:id="@+id/kalima_next"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:padding="8dp"
      android:background="@drawable/kalima_pill"
      android:src="@drawable/kalima_ic_next"
      android:scaleType="fitCenter"
      android:contentDescription="@string/kalima_widget_next" />
  </LinearLayout>

  <!--
    The words take whatever height is left and stay centred in it, so the card
    still looks composed at any size the user drags it to.
  -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
      android:id="@+id/kalima_word"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:maxLines="1"
      android:ellipsize="end"
      android:textSize="24sp"
      android:textStyle="bold"
      android:textDirection="ltr"
      android:textColor="@color/kalima_on_brand"
      android:text="Serenity" />

    <ImageView
      android:layout_width="44dp"
      android:layout_height="1dp"
      android:layout_marginTop="9dp"
      android:layout_marginBottom="9dp"
      android:contentDescription="@null"
      android:background="@drawable/kalima_divider" />

    <TextView
      android:id="@+id/kalima_meaning"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:maxLines="2"
      android:ellipsize="end"
      android:textSize="16sp"
      android:autoSizeTextType="uniform"
      android:autoSizeMinTextSize="11sp"
      android:autoSizeMaxTextSize="16sp"
      android:textColor="@color/kalima_on_brand"
      android:text="@string/kalima_widget_empty" />
  </LinearLayout>

</LinearLayout>
